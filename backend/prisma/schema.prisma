generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CredentialKind {
  OAUTH_CLIENT_SECRET
  WEBHOOK_SECRET
}

enum PersonType {
  STAFF
  TEACHER
  STUDENT
  PARENT
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum ImportStatus {
  VALIDATING
  FAILED
  APPLIED
}

model Tenant {
  id                    String                  @id @default(uuid())
  code                  String                  @unique
  eduplusTenantId       String?                 @unique @map("eduplus_tenant_id")
  name                  String
  issuerUrl             String?                 @map("issuer_url")
  authorizationEndpoint String?                 @map("authorization_endpoint")
  tokenEndpoint         String?                 @map("token_endpoint")
  jwksUri               String?                 @map("jwks_uri")
  status                TenantStatus            @default(ACTIVE)
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  credentials           TenantCredential[]
  webhookReceipts       WebhookReceipt[]
  appSessions           AppSession[]
  directorySyncRuns     DirectorySyncRun[]
  people                Person[]
  classrooms            Classroom[]
  courses               Course[]
  teachingAssignments   TeachingAssignment[]
  parentStudentLinks    ParentStudentRelation[]
  exams                 Exam[]
  examSubjects          ExamSubject[]
  scores                Score[]
  scoreImports          ScoreImport[]
  scoreImportErrors     ScoreImportError[]

  @@map("tenants")
}

model TenantCredential {
  id                String         @id @default(uuid())
  tenantId          String         @map("tenant_id")
  kind              CredentialKind
  clientId          String?        @map("client_id")
  ciphertext        Bytes
  iv                Bytes
  authenticationTag Bytes          @map("authentication_tag")
  keyVersion        Int            @default(1) @map("key_version")
  revokedAt         DateTime?      @map("revoked_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind])
  @@index([tenantId, revokedAt])
  @@map("tenant_credentials")
}

model WebhookReceipt {
  eventId     String   @id @map("event_id")
  tenantId    String?  @map("tenant_id")
  eventName   String   @map("event_name")
  payloadHash String   @map("payload_hash")
  receivedAt  DateTime @default(now()) @map("received_at")
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, receivedAt])
  @@map("webhook_receipts")
}

model AppSession {
  id                       String     @id @default(uuid())
  tenantId                 String     @map("tenant_id")
  personId                 String?    @map("person_id")
  identityId               String     @map("identity_id")
  identityType             PersonType @map("identity_type")
  tokenHash                String     @unique @map("token_hash")
  refreshCiphertext        Bytes?     @map("refresh_ciphertext")
  refreshIv                Bytes?     @map("refresh_iv")
  refreshAuthenticationTag Bytes?     @map("refresh_authentication_tag")
  expiresAt                DateTime   @map("expires_at")
  revokedAt                DateTime?  @map("revoked_at")
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")
  tenant                   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person                   Person?    @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([tenantId, identityId, revokedAt])
  @@map("app_sessions")
}

model DirectorySyncRun {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  requestedBy String     @map("requested_by")
  status      SyncStatus @default(RUNNING)
  counts      Json?
  errorCode   String?    @map("error_code")
  startedAt   DateTime   @default(now()) @map("started_at")
  finishedAt  DateTime?  @map("finished_at")
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
  @@map("directory_sync_runs")
}

model Person {
  id                  String                  @id @default(uuid())
  tenantId            String                  @map("tenant_id")
  eduplusId           String                  @map("eduplus_id")
  type                PersonType
  name                String
  email               String?
  active              Boolean                 @default(true)
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appSessions         AppSession[]
  teachingAssignments TeachingAssignment[]
  parentRelations     ParentStudentRelation[] @relation("ParentPerson")
  studentRelations    ParentStudentRelation[] @relation("StudentPerson")
  createdExams        Exam[]                  @relation("ExamCreator")
  scores              Score[]                 @relation("ScoreStudent")
  gradedScores        Score[]                 @relation("ScoreGrader")
  scoreImports        ScoreImport[]           @relation("ScoreImportCreator")

  @@unique([tenantId, eduplusId])
  @@unique([tenantId, id])
  @@index([tenantId, type, active])
  @@map("people")
}

model Classroom {
  id          String               @id @default(uuid())
  tenantId    String               @map("tenant_id")
  eduplusId   String               @map("eduplus_id")
  name        String
  gradeName   String?              @map("grade_name")
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments TeachingAssignment[]
  exams       Exam[]

  @@unique([tenantId, eduplusId])
  @@unique([tenantId, id])
  @@index([tenantId, active])
  @@map("classrooms")
}

model Course {
  id           String               @id @default(uuid())
  tenantId     String               @map("tenant_id")
  eduplusId    String               @map("eduplus_id")
  code         String?
  name         String
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments  TeachingAssignment[]
  examSubjects ExamSubject[]

  @@unique([tenantId, eduplusId])
  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("courses")
}

model TeachingAssignment {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  eduplusId   String    @map("eduplus_id")
  teacherId   String    @map("teacher_id")
  classroomId String    @map("classroom_id")
  courseId    String    @map("course_id")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher     Person    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eduplusId])
  @@index([tenantId, teacherId, active])
  @@index([tenantId, classroomId, courseId])
  @@map("teaching_assignments")
}

model ParentStudentRelation {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  eduplusId String   @map("eduplus_id")
  parentId  String   @map("parent_id")
  studentId String   @map("student_id")
  relation  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Person   @relation("ParentPerson", fields: [parentId], references: [id], onDelete: Cascade)
  student   Person   @relation("StudentPerson", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eduplusId])
  @@unique([tenantId, parentId, studentId])
  @@index([tenantId, studentId, active])
  @@map("parent_student_relations")
}

model Exam {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  creatorId   String        @map("creator_id")
  classroomId String        @map("classroom_id")
  title       String
  type        String
  examDate    DateTime      @map("exam_date")
  status      ExamStatus    @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  withdrawnAt DateTime?     @map("withdrawn_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator     Person        @relation("ExamCreator", fields: [tenantId, creatorId], references: [tenantId, id], onDelete: Restrict)
  classroom   Classroom     @relation(fields: [tenantId, classroomId], references: [tenantId, id], onDelete: Restrict)
  subjects    ExamSubject[]
  scores      Score[]
  imports     ScoreImport[]

  @@unique([tenantId, id])
  @@index([tenantId, status, examDate])
  @@index([tenantId, classroomId, examDate])
  @@map("exams")
}

model ExamSubject {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  examId       String   @map("exam_id")
  courseId     String   @map("course_id")
  maximumScore Decimal  @map("maximum_score") @db.Decimal(8, 2)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam         Exam     @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Cascade)
  course       Course   @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Restrict)
  scores       Score[]

  @@unique([tenantId, id])
  @@unique([tenantId, examId, courseId])
  @@unique([tenantId, examId, id])
  @@index([tenantId, examId, displayOrder])
  @@map("exam_subjects")
}

model Score {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  examId    String      @map("exam_id")
  subjectId String      @map("subject_id")
  studentId String      @map("student_id")
  graderId  String      @map("grader_id")
  value     Decimal?    @db.Decimal(8, 2)
  absent    Boolean     @default(false)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam      Exam        @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Cascade)
  subject   ExamSubject @relation(fields: [tenantId, examId, subjectId], references: [tenantId, examId, id], onDelete: Cascade)
  student   Person      @relation("ScoreStudent", fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  grader    Person      @relation("ScoreGrader", fields: [tenantId, graderId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, examId, studentId, subjectId])
  @@index([tenantId, studentId, examId])
  @@index([tenantId, examId, subjectId])
  @@map("scores")
}

model ScoreImport {
  id          String             @id @default(uuid())
  tenantId    String             @map("tenant_id")
  examId      String             @map("exam_id")
  createdById String             @map("created_by_id")
  filename    String
  status      ImportStatus       @default(VALIDATING)
  totalRows   Int                @default(0) @map("total_rows")
  appliedRows Int                @default(0) @map("applied_rows")
  createdAt   DateTime           @default(now()) @map("created_at")
  completedAt DateTime?          @map("completed_at")
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam        Exam               @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Cascade)
  createdBy   Person             @relation("ScoreImportCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict)
  errors      ScoreImportError[]

  @@unique([tenantId, id])
  @@index([tenantId, examId, createdAt])
  @@map("score_imports")
}

model ScoreImportError {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  importId    String      @map("import_id")
  rowNumber   Int         @map("row_number")
  code        String
  message     String
  rawValue    Json?       @map("raw_value")
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scoreImport ScoreImport @relation(fields: [tenantId, importId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, importId, rowNumber])
  @@map("score_import_errors")
}
